APP_NAME="ADHERI"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://advocatesforhealthandrights.org

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_cpanel_db_name
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

SESSION_NAME=adheri_session

MAIL_FROM=info@advocatesforhealthandrights.org
MAIL_FROM_NAME="ADHERI"
MAIL_INQUIRY_TO=contactus@advocatesforhealthandrights.org

# Resend (https://resend.com) — verify MAIL_FROM domain before sending
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ADHERI Mail (private webmail at /mail) — separate from site contact forms
MAIL_DOMAIN=advocatesforhealthandrights.org
MAIL_APP_NAME="ADHERI Mail"
MAIL_PATH=/mail
MAIL_URL=https://advocatesforhealthandrights.org/mail/login
MAIL_ADMIN_EMAIL=info@advocatesforhealthandrights.org
MAIL_ADMIN_DISPLAY_NAME="ADHERI"
MAIL_ADMIN_PASSWORD=
MAIL_CATCH_ALL_EMAIL=
MAIL_MAX_ATTACHMENT_BYTES=10485760
MAIL_MAX_ATTACHMENTS=10
MAIL_SETUP_TOKEN=

# Deprecated — recovery emails are per-account (set at first sign-in). Kept only for reference.
# PASSWORD_RECOVERY_INBOX=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
DONATION_MIN_AMOUNT=1000
DONATION_CURRENCY=NGN
